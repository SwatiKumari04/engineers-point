# Copy this file to `.env` and adjust as needed.
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
ADMIN_ID=admin@nitjsr

# MongoDB (Atlas): Atlas > Connect > Drivers. Replace USER/PASS with your DB user.
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=engineers_point

# Secret for signing login tokens (JWT). Use a long random string in production.
JWT_SECRET=replace-with-a-long-random-string

# Email delivery for student login passwords.
# Leave BREVO_API_KEY and SMTP_HOST empty for dev mode: passwords are returned
# in the API response and printed to the server console.
BREVO_API_KEY=
BREVO_SENDER=

# Local alternative: plain SMTP (e.g. Gmail with an app password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=